# X Omni configuration
# Copy this file to .env.local and fill it in. .env.local is gitignored
# and must never be committed.

# ---------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------
# 1 = require Google sign-in (correct for anything reachable over Tailscale)
# 0 = no auth, local development only.
#     Core binds 127.0.0.1 only, BUT Tailscale serve proxies remote
#     traffic through loopback too -- so with auth off, anyone on your
#     tailnet is indistinguishable from you at the keyboard.
#     Never leave this at 0 while Tailscale serve is running.
XOMNI_AUTH_ENABLED=1

# From Google Cloud Console -> APIs & Services -> Credentials
# -> OAuth 2.0 Client ID (type: Web application).
XOMNI_GOOGLE_CLIENT_ID=
XOMNI_GOOGLE_CLIENT_SECRET=

# Your Tailscale HTTPS hostname, no trailing slash.
# Find it with: tailscale status --json  (look for DNSName)
# Example: https://omega.tail1a2b3c.ts.net
# Leave blank until Tailscale serve is set up.
XOMNI_PUBLIC_ORIGIN=

# Persist this so sessions survive a Core restart. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
XOMNI_SESSION_SECRET=

XOMNI_SESSION_TTL_DAYS=30

# ---------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------
XOMNI_PORT=8100

# ---------------------------------------------------------------------
# Model
# ---------------------------------------------------------------------
# GPU0 free-VRAM (MiB) that counts as "the previous worker actually let
# go". Measured baseline on Omega: ~16050 MiB free after a clean stop.
XOMNI_VRAM_FREE_THRESHOLD_MIB=15000
XOMNI_GPU_INDEX=0

# 32K is mandatory. Do not lower this.
XOMNI_CONTEXT_TOKENS=32768
XOMNI_MAX_RESPONSE_TOKENS=1536
XOMNI_TEMPERATURE=0.4
